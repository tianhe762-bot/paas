# 入站 API 鉴权密钥（Adapter/外部机器人调用 /api/v1/message/inbound 时通过 X-Api-Key 头携带）
API_KEY=please-change-me-strong-api-key

# 管理界面初始账号（首次启动写入数据库，之后以数据库为准）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=please-change-me-strong-password

# 敏感信息加密密钥：bot token/secret 落库前用此密钥加密
# 未设置时自动生成并保存到 data/secret.key（删除该文件会导致已存凭证无法解密）
SECRET_KEY=

# 时区
TZ=Asia/Shanghai

# Telegram 走显式 HTTP 代理时的地址（默认 host 网络模式可直连，留空即可）
# 若改为 bridge 网络且宿主机 Clash 开启了 allow-lan，可填 http://<宿主机网关IP>:7890
TELEGRAM_PROXY=

# 服务端口（docker 映射用，容器内固定 8000）
PAAS_HTTP_PORT=8000
